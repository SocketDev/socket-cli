import childProcess from 'node:child_process'
import {
  chmodSync,
  copyFileSync,
  existsSync,
  mkdirSync,
  mkdtempSync,
  readFileSync,
  realpathSync,
  rmSync,
  statSync,
  symlinkSync,
  writeFileSync,
} from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { setTimeout as sleep } from 'node:timers/promises'

import cmdShim from 'cmd-shim'
import { afterEach, beforeEach, describe, expect, it } from 'vitest'

import { resolveBazelBinary } from './bazel-bin-detect.mts'
import {
  cleanUpBazelOutputRoot,
  makeBazelOutputUserRoot,
  removeBazelTempdir,
  shutDownBazelServer,
} from './bazel-cleanup.mts'
import {
  BazelTimeoutError,
  getBazelEnvironment,
  spawnBazel,
} from './bazel-process.mts'
import { splitBazelFlags } from './bazel-query-runner.mts'

const ARGUMENTS = [
  '',
  'attr("tags", "\\bmaven_coordinates=", @maven//...)',
  '--bazelrc=C:\\Program Files\\Bazel\\custom.bazelrc',
  'C:\\path with spaces\\',
  'quotes "inside" values',
  '&echo injected>bad.txt',
  'literal|pipe<>!^()',
  '%SOCKET_BAZEL_LITERAL%',
  '$HOME `command` $(command)',
  'unicodé',
]

const LAUNCHER = `const fs = require('node:fs')
const record = { args: process.argv.slice(2), cwd: process.cwd(), marker: process.env.SOCKET_BAZEL_LITERAL }
if (process.env.SOCKET_BAZEL_RECORD) { fs.writeFileSync(process.env.SOCKET_BAZEL_RECORD, JSON.stringify(record)) }
process.stdout.write(JSON.stringify(record))
`

function readServerCalls(record: string): unknown[] {
  return readFileSync(record, 'utf8')
    .trim()
    .split('\n')
    .map(line => JSON.parse(line))
}

describe('Bazel process invocation', () => {
  let cwd: string
  let launcher: string
  const servers: number[] = []

  beforeEach(() => {
    cwd = realpathSync(mkdtempSync(path.join(os.tmpdir(), 'bazel process ')))
    launcher = path.join(cwd, 'launcher.cjs')
    writeFileSync(launcher, LAUNCHER)
  })

  afterEach(() => {
    for (const pid of servers.splice(0)) {
      if (isAlive(pid)) {
        process.kill(pid, 'SIGKILL')
      }
    }
    rmSync(cwd, { recursive: true, force: true, maxRetries: 5 })
  })

  it('passes arguments unchanged to a native executable', async () => {
    const executable = path.join(
      cwd,
      process.platform === 'win32' ? 'native launcher.exe' : 'native launcher',
    )
    copyFileSync(process.execPath, executable)
    const result = await spawnBazel(executable, [launcher, ...ARGUMENTS], {
      cwd,
    })
    expect(JSON.parse(result.stdout)).toMatchObject({ args: ARGUMENTS, cwd })
  })

  it('invokes an explicit JavaScript entry point with Node', async () => {
    const bin = await resolveBazelBinary(
      launcher,
      getBazelEnvironment({ PATH: '' }),
      cwd,
    )
    const result = await spawnBazel(bin, ARGUMENTS, {
      cwd,
      env: { SOCKET_BAZEL_LITERAL: 'from supplied environment' },
    })
    expect(JSON.parse(result.stdout)).toEqual({
      args: ARGUMENTS,
      cwd,
      marker: 'from supplied environment',
    })
  })

  it('runs a launcher generated by npm cmd-shim', async () => {
    writeFileSync(launcher, `#!/usr/bin/env node\n${LAUNCHER}`)
    const shim = path.join(cwd, 'bazelisk')
    await cmdShim(launcher, shim)
    const bin = await resolveBazelBinary(
      process.platform === 'win32' ? `${shim}.cmd` : shim,
      getBazelEnvironment(),
      cwd,
    )
    const result = await spawnBazel(bin, ARGUMENTS, { cwd })
    expect(JSON.parse(result.stdout)).toMatchObject({ args: ARGUMENTS, cwd })
  })

  for (const extension of ['cmd', 'bat']) {
    it.skipIf(process.platform !== 'win32')(
      `preserves arguments through an explicit ${extension} launcher outside PATH`,
      async () => {
        const wrapper = path.join(cwd, `outside PATH.${extension}`)
        writeFileSync(
          wrapper,
          `@echo off\r\n"${process.execPath}" "${launcher}" %*\r\n`,
        )
        const bin = await resolveBazelBinary(
          wrapper,
          getBazelEnvironment({ PATH: cwd }),
          cwd,
        )
        const result = await spawnBazel(bin, ARGUMENTS, {
          cwd,
          env: { SOCKET_BAZEL_LITERAL: 'must not expand' },
        })
        expect(JSON.parse(result.stdout)).toEqual({
          args: ARGUMENTS,
          cwd,
          marker: 'must not expand',
        })
      },
    )
  }

  it('normalizes Windows environment key casing', () => {
    const env = getBazelEnvironment(
      { Path: 'supplied path', PATH: 'last value' },
      'win32',
    )
    const keys = Object.keys(env).filter(key => key.toLowerCase() === 'path')
    expect(keys).toHaveLength(1)
    const key = keys[0]
    expect(key && env[key]).toBe('last value')
  })

  function writeServerLauncher(
    installBase: string,
    outputBase: string,
  ): string {
    const record = path.join(cwd, 'server.jsonl')
    writeFileSync(
      launcher,
      `const fs = require('node:fs')
const args = process.argv.slice(2)
fs.appendFileSync(${JSON.stringify(record)}, JSON.stringify({ args, cwd: process.cwd(), marker: process.env.SOCKET_BAZEL_LITERAL }) + '\\n')
if (args.includes('info')) { process.stdout.write(${JSON.stringify(`install_base: ${installBase}\noutput_base: ${outputBase}\n`)}) }
`,
    )
    return record
  }

  function makeServerRoot(): { root: string; installBase: string } {
    const root = makeBazelOutputUserRoot(
      getBazelEnvironment({ SOCKET_BAZEL_OUTPUT_ROOT: cwd }),
      cwd,
    )
    const installBase = path.join(root, 'install', 'hash')
    mkdirSync(installBase, { recursive: true })
    return { root, installBase }
  }

  it('shuts down its own server with the same workspace, startup flags, and environment', async () => {
    const { installBase, root } = makeServerRoot()
    const outputBase = path.join(root, 'workspace hash')
    mkdirSync(outputBase)
    const record = writeServerLauncher(installBase, outputBase)
    const startupFlags = [
      `--bazelrc=${path.join(cwd, 'custom rc')}`,
      `--output_user_root=${root}`,
    ]
    await shutDownBazelServer(
      {
        bin: launcher,
        cwd,
        invocationFlags: [],
        outputUserRoot: root,
        bazelRc: path.join(cwd, 'custom rc'),
        env: { SOCKET_BAZEL_LITERAL: 'shutdown environment' },
      },
      AbortSignal.timeout(30_000),
    )
    expect(readServerCalls(record)).toEqual([
      {
        args: [...startupFlags, 'info', 'install_base', 'output_base'],
        cwd,
        marker: 'shutdown environment',
      },
      {
        args: [...startupFlags, 'shutdown'],
        cwd,
        marker: 'shutdown environment',
      },
    ])
    expect(await removeBazelTempdir(root)).toBe(true)
  })

  it('shuts down the server it started in an explicit output base', async () => {
    const { installBase, root } = makeServerRoot()
    const callerOutputBase = path.join(cwd, 'caller cache')
    mkdirSync(callerOutputBase)
    const record = writeServerLauncher(installBase, callerOutputBase)
    await shutDownBazelServer(
      {
        bin: launcher,
        cwd,
        invocationFlags: [],
        outputUserRoot: root,
        bazelOutputBase: callerOutputBase,
      },
      AbortSignal.timeout(30_000),
    )
    expect(readServerCalls(record)).toEqual([
      expect.objectContaining({
        args: expect.arrayContaining(['info', 'install_base', 'output_base']),
      }),
      expect.objectContaining({
        args: [
          `--output_user_root=${root}`,
          `--output_base=${callerOutputBase}`,
          'shutdown',
        ],
      }),
    ])
  })

  it('leaves a server selected by an rc install and output base alone', async () => {
    const { root } = makeServerRoot()
    const callerInstallBase = path.join(cwd, 'caller install base')
    const callerOutputBase = path.join(cwd, 'caller output base')
    mkdirSync(callerInstallBase)
    mkdirSync(callerOutputBase)
    const record = writeServerLauncher(callerInstallBase, callerOutputBase)
    await shutDownBazelServer(
      {
        bin: launcher,
        cwd,
        invocationFlags: [],
        outputUserRoot: root,
        bazelRc: path.join(cwd, 'custom rc'),
      },
      AbortSignal.timeout(30_000),
    )
    expect(readServerCalls(record)).toEqual([
      expect.objectContaining({
        args: expect.arrayContaining(['info', 'install_base', 'output_base']),
      }),
    ])
  })

  it('stops its own server when Bazel cannot report its bases', async () => {
    const { root } = makeServerRoot()
    const server = startFakeServer(path.join(root, 'workspace hash'))
    writeFileSync(launcher, 'process.exit(1)\n')
    expect(
      await cleanUpBazelOutputRoot(
        root,
        new Map([
          [
            cwd,
            { bin: launcher, cwd, invocationFlags: [], outputUserRoot: root },
          ],
        ]),
      ),
    ).toBe(true)
    expect(isAlive(server)).toBe(false)
    expect(existsSync(root)).toBe(false)
  }, 30_000)

  it('stops its own server when shutdown leaves it running', async () => {
    const { installBase, root } = makeServerRoot()
    const callerOutputBase = path.join(cwd, 'caller cache')
    const server = startFakeServer(callerOutputBase)
    writeServerLauncher(installBase, callerOutputBase)
    expect(
      await cleanUpBazelOutputRoot(
        root,
        new Map([
          [
            cwd,
            {
              bin: launcher,
              cwd,
              invocationFlags: [],
              outputUserRoot: root,
              bazelOutputBase: callerOutputBase,
            },
          ],
        ]),
      ),
    ).toBe(true)
    expect(isAlive(server)).toBe(false)
    expect(existsSync(root)).toBe(false)
  }, 30_000)

  it('leaves a server in a caller output base running', async () => {
    const { root } = makeServerRoot()
    const callerInstallBase = path.join(cwd, 'caller install base')
    const callerOutputBase = path.join(cwd, 'caller output base')
    mkdirSync(callerInstallBase)
    const server = startFakeServer(callerOutputBase)
    writeServerLauncher(callerInstallBase, callerOutputBase)
    expect(
      await cleanUpBazelOutputRoot(
        root,
        new Map([
          [
            cwd,
            { bin: launcher, cwd, invocationFlags: [], outputUserRoot: root },
          ],
        ]),
      ),
    ).toBe(true)
    expect(isAlive(server)).toBe(true)
    expect(existsSync(root)).toBe(false)
  })

  it.skipIf(process.platform === 'win32')(
    'removes read-only directories without changing linked user data',
    async () => {
      const root = makeBazelOutputUserRoot(
        getBazelEnvironment({ SOCKET_BAZEL_OUTPUT_ROOT: cwd }),
        cwd,
      )
      const readonly = path.join(root, 'read-only repository')
      mkdirSync(readonly)
      writeFileSync(path.join(readonly, 'data'), 'owned')
      const userDirectory = path.join(cwd, 'user files')
      mkdirSync(userDirectory)
      writeFileSync(path.join(userDirectory, 'keep'), 'user data')
      chmodSync(userDirectory, 0o750)
      symlinkSync(userDirectory, path.join(readonly, 'user link'))
      chmodSync(readonly, 0o500)
      expect(await removeBazelTempdir(root)).toBe(true)
      expect(readFileSync(path.join(userDirectory, 'keep'), 'utf8')).toBe(
        'user data',
      )
      expect(statSync(userDirectory).mode & 0o777).toBe(0o750)
    },
  )

  it('bounds a real subprocess with a timeout', async () => {
    writeFileSync(launcher, 'setInterval(() => {}, 1000)\n')
    await expect(
      spawnBazel(launcher, [], { cwd, timeout: 100 }),
    ).rejects.toBeInstanceOf(BazelTimeoutError)
  })

  it('cancels a real subprocess', async () => {
    writeFileSync(launcher, 'setInterval(() => {}, 1000)\n')
    const controller = new AbortController()
    const result = spawnBazel(launcher, [], { cwd, signal: controller.signal })
    controller.abort()
    await expect(result).rejects.toMatchObject({ name: 'AbortError' })
  })

  it('stops what a launcher started when the timeout expires', async () => {
    const record = writeParentLauncher({ detached: false })
    await expect(
      spawnBazel(launcher, [], { cwd, timeout: 500 }),
    ).rejects.toBeInstanceOf(BazelTimeoutError)
    expect(await waitForExit(readChildPid(record))).toBe(true)
  })

  it('stops what a launcher started when cancelled', async () => {
    const record = writeParentLauncher({ detached: false })
    const controller = new AbortController()
    const result = spawnBazel(launcher, [], { cwd, signal: controller.signal })
    await waitForFile(record)
    controller.abort()
    await expect(result).rejects.toMatchObject({ name: 'AbortError' })
    expect(await waitForExit(readChildPid(record))).toBe(true)
  })

  it('settles a timeout when an escaped process keeps the output open', async () => {
    const record = writeParentLauncher({ detached: true })
    const startedAt = Date.now()
    try {
      await expect(
        spawnBazel(launcher, [], { cwd, timeout: 500 }),
      ).rejects.toBeInstanceOf(BazelTimeoutError)
      expect(Date.now() - startedAt).toBeLessThan(15_000)
    } finally {
      process.kill(readChildPid(record), 'SIGKILL')
    }
  }, 30_000)

  function writeParentLauncher(options: { detached: boolean }): string {
    const record = path.join(cwd, 'child.pid')
    writeFileSync(
      launcher,
      `const { spawn } = require('node:child_process')
const fs = require('node:fs')
const child = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { detached: ${options.detached}, stdio: 'inherit' })
fs.writeFileSync(${JSON.stringify(record)}, String(child.pid))
${options.detached ? 'child.unref()' : ''}
`,
    )
    return record
  }

  function startFakeServer(outputBase: string): number {
    const server = childProcess.spawn(
      process.execPath,
      ['-e', 'setInterval(() => {}, 1000)'],
      { detached: true, stdio: 'ignore' },
    )
    server.unref()
    const { pid } = server
    if (pid === undefined) {
      throw new Error('Fake Bazel server did not start')
    }
    servers.push(pid)
    mkdirSync(path.join(outputBase, 'server'), { recursive: true })
    writeFileSync(
      path.join(outputBase, 'server', 'server.pid.txt'),
      String(pid),
    )
    return pid
  }
})

function readChildPid(record: string): number {
  return Number(readFileSync(record, 'utf8'))
}

function isAlive(pid: number): boolean {
  try {
    process.kill(pid, 0)
    return true
  } catch {
    return false
  }
}

async function waitForExit(pid: number): Promise<boolean> {
  const deadline = Date.now() + 5_000
  while (isAlive(pid) && Date.now() < deadline) {
    // eslint-disable-next-line no-await-in-loop
    await sleep(50)
  }
  return !isAlive(pid)
}

async function waitForFile(file: string): Promise<void> {
  while (!existsSync(file)) {
    // eslint-disable-next-line no-await-in-loop
    await sleep(50)
  }
}

describe('splitBazelFlags', () => {
  it('handles existing unquoted flags and CRLF', () => {
    expect(splitBazelFlags('--config=ci\r\n --keep_going')).toEqual([
      '--config=ci',
      '--keep_going',
    ])
    expect(splitBazelFlags(undefined)).toEqual([])
  })

  it('keeps quoted paths and Windows backslashes', () => {
    expect(
      splitBazelFlags(
        '--define="data=C:\\Program Files\\data\\" --config=\'Windows CI\'',
      ),
    ).toEqual([
      '--define=data=C:\\Program Files\\data\\',
      '--config=Windows CI',
    ])
  })

  it('preserves empty arguments and literal shell characters', () => {
    expect(splitBazelFlags('"" --define="x=$HOME & %PATH%"')).toEqual([
      '',
      '--define=x=$HOME & %PATH%',
    ])
  })

  it('accepts doubled quotes within a quoted value', () => {
    expect(splitBazelFlags('--define="a=""quoted"""')).toEqual([
      '--define=a="quoted"',
    ])
  })

  it('keeps apostrophes inside a value literal', () => {
    expect(
      splitBazelFlags("--action_env=GREETING=don't --define=owner=O'Brien"),
    ).toEqual(["--action_env=GREETING=don't", "--define=owner=O'Brien"])
  })

  it('reports malformed quoting', () => {
    expect(() => splitBazelFlags('--define="missing end')).toThrow(
      /unterminated quote/,
    )
  })
})
