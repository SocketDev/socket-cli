// Artifact-failure fixture for ../../../socket-facts.plugin.scala: every module resolves, but ok has no
// tests-classifier jar, so the only failure is an artifact that names no module. app depends on core,
// whose update sbt also runs for app. Reuses ../failure/localrepo, generated by ../smoke-test-failure.sh.
organization in ThisBuild := "demo"
version in ThisBuild := "0.1.0"

lazy val stubs = Seq(
  resolvers := Seq(
    "Socket Stubs" at s"file://${(baseDirectory in ThisBuild).value.getAbsolutePath}/../failure/localrepo"
  ) ++ resolvers.value
)

lazy val core = (project in file("core"))
  .settings(stubs)
  .settings(
    libraryDependencies += "demo.fail" % "ok" % "1.0",
    libraryDependencies += "demo.fail" % "ok" % "1.0" classifier "tests"
  )

lazy val app = (project in file("app")).settings(stubs).dependsOn(core)
