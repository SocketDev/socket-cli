<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>demo</groupId>
  <artifactId>excluded-scope</artifactId>
  <version>1.0</version>
  <properties>
    <stub.repo.url>file://${maven.multiModuleProjectDirectory}/localrepo</stub.repo.url>
  </properties>
  <repositories>
    <repository>
      <id>socket-stubs</id>
      <url>${stub.repo.url}</url>
      <releases>
        <enabled>true</enabled>
        <checksumPolicy>ignore</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <!-- A managed scope is not derived from the parent's: managed and deep stay compile below test. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>demo.excl</groupId>
        <artifactId>managed</artifactId>
        <version>1.0</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>demo.excl</groupId>
        <artifactId>mgd-test</artifactId>
        <version>1.0</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>demo.excl</groupId>
        <artifactId>deep</artifactId>
        <version>1.0</version>
        <scope>compile</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>demo.excl</groupId>
      <artifactId>testlib</artifactId>
      <version>1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>demo.excl</groupId>
      <artifactId>lib</artifactId>
      <version>1.0</version>
    </dependency>
    <dependency>
      <groupId>demo.excl</groupId>
      <artifactId>dtest</artifactId>
      <version>1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>demo.excl</groupId>
      <artifactId>k2</artifactId>
      <version>1.0</version>
    </dependency>
  </dependencies>
</project>
