<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>demo</groupId>
    <artifactId>root</artifactId>
    <version>1.0</version>
  </parent>
  <artifactId>app</artifactId>
  <dependencies>
    <!-- internal reactor modules -> inter-module edges, bare-id components. lib's jar comes in
         through mid, which excludes demo.ext:libdep, so only lib's test-jar further down brings
         libdep, and the walk reaches the jar first. -->
    <dependency>
      <groupId>demo</groupId>
      <artifactId>mid</artifactId>
      <version>1.0</version>
    </dependency>
    <!-- external prod dep (stub artifact from the generated repo, no transitive deps) -->
    <dependency>
      <groupId>demo.ext</groupId>
      <artifactId>tool</artifactId>
      <version>1.0</version>
    </dependency>
    <!-- test dep -> dev flag; pulls harness-core transitively -->
    <dependency>
      <groupId>demo.ext</groupId>
      <artifactId>harness</artifactId>
      <version>1.0</version>
      <scope>test</scope>
    </dependency>
    <!-- Scope-conflict pair: both pull demo.ext:shared at the same depth. Because the test
         dep is declared first, Maven keeps shared under the test parent but selects compile, the
         scope conflict-prod's path gives it, so shared is prod and reached through
         conflict-prod's edge. -->
    <dependency>
      <groupId>demo.ext</groupId>
      <artifactId>conflict-test</artifactId>
      <version>1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>demo.ext</groupId>
      <artifactId>conflict-prod</artifactId>
      <version>1.0</version>
    </dependency>
    <!-- dup-io depends on dup-util, which Maven keeps as this direct dependency. -->
    <dependency>
      <groupId>demo.ext</groupId>
      <artifactId>dup-util</artifactId>
      <version>1.0</version>
    </dependency>
    <dependency>
      <groupId>demo.ext</groupId>
      <artifactId>dup-io</artifactId>
      <version>1.0</version>
    </dependency>
    <!-- container-lib (compile) depends on container-api, which Maven keeps as provided. -->
    <dependency>
      <groupId>demo.ext</groupId>
      <artifactId>container-api</artifactId>
      <version>1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>demo.ext</groupId>
      <artifactId>container-lib</artifactId>
      <version>1.0</version>
    </dependency>
    <dependency>
      <groupId>demo</groupId>
      <artifactId>lib</artifactId>
      <version>1.0</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
