<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v17.0</VSToolsPath>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Demo.Ext.Logging" Version="1.0.0" /></ItemGroup>
  <!-- Visual Studio-only, as in web application projects: absent from the .NET SDK. -->
