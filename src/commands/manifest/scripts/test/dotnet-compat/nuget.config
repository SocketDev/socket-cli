<?xml version="1.0" encoding="utf-8"?>
<!-- Demo.* stubs come only from the feed make-stub-feed.py generates; the
     SDK's own packs (targeting, apphost, NETStandard.Library) from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="stubs" value="stub-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="stubs">
      <package pattern="Demo.*" />
      <package pattern="runtime.win-x64.Demo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
