{
  "ai": {
    "localAssist": true
  },
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "socket-cli",
  "bundle": {
    "ref": "fleet-pack-6a05f83a5c85b54d67ccf2068090e989086a167a",
    "cascadeSha": "6a05f83a5c85b54d67ccf2068090e989086a167a"
  },
  "repo": {
    "type": "mono"
  },
  "build": {
    "from": "npm-registry",
    "type": "js"
  },
  "release": {
    "latestDistTagBranch": "v1.x",
    "publishedPackages": [
      "socket",
      "@socketsecurity/cli",
      "@socketsecurity/cli-with-sentry"
    ]
  },
  "vite": {
    "allowEsbuild": "esbuild resolves only as vite 8's optional peer and is never invoked; nothing imports it and the bundler is rolldown"
  },
  "contentPolicy": {
    "class": "dual-use",
    "packages": [
      "packages/cli",
      "packages/package-builder/templates/socket-package"
    ]
  },
  "bornTested": {
    "grandfathered": [
      "scripts/repo/bootstrap/prepare.mts",
      "scripts/repo/build.mts",
      "scripts/repo/check/cli-types-are-sound.mts",
      "scripts/repo/clean-cache.mts",
      "scripts/repo/stage-publish-cli-exe.mts",
      "scripts/repo/validate-no-cdn-refs.mts",
      "scripts/repo/warm-dlx-cache.mts"
    ]
  }
}
