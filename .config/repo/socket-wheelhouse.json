{
  "ai": {
    "localAssist": true
  },
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "socket-cli",
  "bundle": {
    "ref": "fleet-pack-d9f8e5800f4e961267e5994ee75b73eb618ff79f",
    "cascadeSha": "d9f8e5800f4e961267e5994ee75b73eb618ff79f"
  },
  "repo": {
    "type": "mono"
  },
  "build": {
    "from": "npm-registry",
    "type": "js"
  },
  "release": {
    "latestDistTagBranch": "v1.x",
    "publishedPackages": [
      "socket",
      "@socketsecurity/cli",
      "@socketsecurity/cli-with-sentry"
    ]
  },
  "vite": {
    "allowEsbuild": "esbuild resolves only as vite 8's optional peer and is never invoked; nothing imports it and the bundler is rolldown"
  },
  "contentPolicy": {
    "class": "dual-use",
    "packages": [
      "packages/cli",
      "packages/package-builder/templates/socket-package"
    ]
  }
}
