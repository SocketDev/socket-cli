{
  "extends": "./tsconfig.check.base.json",
  "compilerOptions": {
    "rootDir": "../.."
  },
  "include": [
    "../../scripts/**/*.mts",
    "../../.claude/hooks/repo/**/*.mts",
    "../../.claude/hooks/fleet/**/*.mts",
