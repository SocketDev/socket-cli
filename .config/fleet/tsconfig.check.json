{
  "//": "The repo half comes last so a member's own compilerOptions win. Path aliases live there: without it the type gate resolved none of a member's src/external/* mappings, because the root tsconfig is a sibling of this chain rather than an ancestor.",
  "extends": ["./tsconfig.check.base.json", "../repo/tsconfig.check.json"],
  "compilerOptions": {
    "rootDir": "../.."
  },
  "include": [
    "../../scripts/**/*.mts",
    "../../.claude/hooks/repo/**/*.mts",
    "../../.claude/hooks/fleet/**/*.mts",
    "../../.config/fleet/markdownlint-rules/**/*.mts",
    "../../.config/fleet/oxlint-plugin/**/*.mts",
    "../../.config/fleet/rolldown/**/*.mts",
    "../../src/**/*.d.ts",
    "../../src/**/*.d.mts",
    "../../test/**/*.mts"
  ],
  "exclude": [
    "../../.cache",
    "../../build",
    "../../coverage",
    "../../dist",
    "../../node_modules",
    "../../scripts/fleet",
    "../../template",
    "**/_shared/**",
    "**/node_modules"
  ]
}
