{
  "mcpServers": {
    "chrome-devtools": {
      "command": "pnpm",
      "args": [
        "exec",
        "chrome-devtools-mcp",
        "--isolated",
        "--category-extensions",
        "--no-category-performance",
        "--no-category-emulation"
      ]
    },
    "fff": {
      "command": "fff-mcp",
      "args": []
    },
    "janus-multi": {
      "command": "node",
      "args": ["scripts/fleet/janus-multi-mcp.mts"]
    },
    "playwright": {
      "command": "pnpm",
      "args": [
        "exec",
        "playwright-mcp",
        "--isolated",
        "--init-script",
        ".config/fleet/playwright/agent-banner.js"
      ]
    },
    "refero": {
      "type": "http",
      "url": "https://api.refero.design/mcp"
    }
  }
}
