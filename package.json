  "lint-staged": {
    "*.{cjs,cts,js,json,md,mjs,mts,ts}": [
      "oxfmt --write"
    ]
  },
  "typeCoverage": {
    "atLeast": 95,
    "cache": true,
    "ignore-files": "test/*",
    "ignore-non-null-assertion": true,
    "ignore-type-assertion": true,
    "ignoreAsAssertion": true,
    "ignoreCatch": true,
    "ignoreEmptyType": true,
    "strict": true
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.25.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12.0.2",
    "pnpm": ">=11.0.5"
  },
  "allowScripts": {
    "cpu-features": false,
    "protobufjs": false,
    "puppeteer": false,
    "rolldown": true,
    "postject": false,
    "ssh2": false
  },
  "contentPolicy": {
    "class": "dual-use"
  }
}
